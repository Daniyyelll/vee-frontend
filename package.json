{
  "name": "vee-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost --port 3000 --strictPort",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json vitest.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json vitest.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}
