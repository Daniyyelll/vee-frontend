{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/collection", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/order-confirmation", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/products/:slug", "destination": "/index.html" }
  ]
}
